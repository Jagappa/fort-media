# Copy to .env and fill in real values. NEVER commit .env.
PORT=5001

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fort-media?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173

# ─── Cloudinary — media storage ───
# Required in production. Render's free plan wipes backend/uploads on every
# restart/redeploy/sleep, so uploaded media must not live on its disk.
# Leave all three blank locally to keep writing to backend/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fort-media

# Optional SMTP (partner credentials + password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# FRONTEND_URL=http://localhost:5173
